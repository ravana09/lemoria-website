# ------------------------------------------------------------------
# Lemoria Luxe website — email settings
# Copy this file to .env and fill in the values. Never share .env.
# ------------------------------------------------------------------

# Who receives every enquiry and booking from the website.
# For testing, put your own email address here.
MAIL_TO=info@lemoria.space

# The "from" name and address on emails. With Gmail this must be the SMTP_USER address.
MAIL_FROM="Lemoria Luxe <info@lemoria.space>"

# SMTP account used to send the emails.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER = the Gmail address,
#        SMTP_PASS = a 16-character "App password" (Google Account > Security > 2-Step Verification > App passwords).
#        Your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@lemoria.space
SMTP_PASS=

# true = do not send, just print the emails in the terminal (useful while testing the forms).
# Leave false once SMTP_PASS is filled in.
MAIL_DRY_RUN=false

# Port for the production server (npm start).
PORT=3000
